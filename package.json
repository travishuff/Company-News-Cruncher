{
  "name": "company-news-cruncher",
  "version": "1.0.0",
  "description": "An intelligent news analysis tool for any company's newsflow.",
  "type": "module",
  "main": "server/server.ts",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun run typecheck && bun run build:client",
    "build:client": "bun build client/js/index.ts --outfile client/js/index.js --target browser",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "bun run build:client && bun server/server.ts",
    "test": "bun run build:client && bun test",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/travishuff/company-news-cruncher.git"
  },
  "author": "Travis Huff",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/travishuff/company-news-cruncher/issues"
  },
  "homepage": "https://github.com/travishuff/company-news-cruncher#readme",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.6",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
